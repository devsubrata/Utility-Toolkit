{
    "manifest_version": 3,
    "name": "Utility Toolkit",
    "version": "1.0",
    "description": "A Chrome extension containing Utility widgets.",
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "permissions": ["scripting", "activeTab", "tabs", "downloads"],
    "host_permissions": ["<all_urls>", "http://localhost:3000/*"],
    "web_accessible_resources": [
        {
            "resources": ["scripts/API/api_key.json", "scripts/libs/*.js", "scripts/Data/*.json", "scripts/*.js", "styles/*.css"],
            "matches": ["<all_urls>"]
        }
    ],
    "commands": {
        "look-up-bar": {
            "suggested_key": {
                "default": "Alt+Shift+F"
            },
            "description": "Open Search Bar"
        },
        "annotation-bar": {
            "suggested_key": {
                "default": "Alt+Shift+D"
            },
            "description": "Open Annotation Bar"
        },
        "frame-shift-player": {
            "suggested_key": {
                "default": "Alt+Shift+M"
            },
            "description": "FrameShift Player"
        }
    }
}
